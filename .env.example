# 아래 명령으로 만든 50자 이상의 값을 넣으세요. 짧거나 뻔하면 세션·CSRF 보호가 약해집니다.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# 개발할 때는 True. 외부에 공개(터널 배포)하는 기기에서만 False 로 바꿉니다.
DEBUG=True

# https 터널 주소로만 서비스할 때 True. 쿠키를 https 로만 보내고 http 접속을 https 로 돌립니다.
# 로컬에서 http://127.0.0.1:8000 으로 확인할 때는 반드시 False 여야 합니다(로그인이 막힙니다).
SECURE=False
DB_HOST=
DB_PORT=3306
DB_NAME=community
DB_USER=axi
DB_PASSWORD=

# 비밀번호 찾기 메일 발송용 (Gmail 앱 비밀번호). 비워두면 메일 발송만 동작하지 않습니다.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=